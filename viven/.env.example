# Viven Environment Variables
# Copy this file to .env.local and fill in your values

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# EPC API (register at https://epc.opendatacommunities.org/)
EPC_API_KEY=

# Google APIs (optional - for enhanced amenity/commute data)
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Mapbox (optional - for map tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Database (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend or SendGrid)
RESEND_API_KEY=

# Anthropic API (for AI-powered Viven Insights)
ANTHROPIC_API_KEY=
